# Supabase — required for everything (auth, Postgres, storage)
NEXT_PUBLIC_SUPABASE_URL=https://ysaovzdjtucywurhtzyx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_vduC1sMT0Mhfo_zg87waJQ_tA0DDdAF

# Server-only — never expose to the browser. Required to provision employee
# logins from the Employees page (supabase.auth.admin.createUser). Find it
# in Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Firebase — chat only (Architecture Document §6).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBlPa9dE3XDQ17EfI4rpMovc9bI-kXB8EM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=macropropoty.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=macropropoty
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=macropropoty.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=31387830407
NEXT_PUBLIC_FIREBASE_APP_ID=1:31387830407:web:60ee5cca5ec5f677331022

# ImageKit — image uploads for Communication (and future Audit/Checklist)
# attachments. Server-only, never exposed to the browser. Find it in the
# ImageKit dashboard under Developer > API Keys (starts with "private_").
IMAGEKIT_PRIVATE_KEY=

# Resend — email sending for Weekly Action Report "Share via Email" (PDF
# attached). Server-only. Get a key at resend.com and a verified sending
# domain/address for RESEND_FROM_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Meta WhatsApp Cloud API — "Share via Business WhatsApp" on Weekly Action
# Report. Server-only. From the Meta for Developers WhatsApp Business
# product: WHATSAPP_PHONE_NUMBER_ID (the sending number's Phone Number ID)
# and WHATSAPP_ACCESS_TOKEN (a permanent System User token).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=