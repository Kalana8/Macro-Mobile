{
  "name": "macro",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:app": "npm run dev -w apps/employee-app",
    "dev:admin": "npm run dev -w apps/admin-dashboard",
