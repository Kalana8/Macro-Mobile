rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chat threads mirror each Postgres `communications` row's recipients into
    // `employeeIds`. Visibility is participant-only, matching migration
    // 0024_communications_no_admin_oversight: there is deliberately NO blanket
    // Admin oversight here. Admins that create or manage a thread add
    // themselves to `employeeIds` (see AddCommunicationModal), so they keep
    // full access to the threads they're part of — but never to threads they
    // were never a member of.
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.employeeIds;

      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.employeeIds;

      match /messages/{messageId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.employeeIds;
      }
    }
  }
}
